NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# PostgreSQL connection string. Keep credentials local and update this URL if
# the POSTGRES_* values below are changed.
DATABASE_URL=postgresql://task_app:task_app_local@localhost:5432/task_management?schema=public

# Local development credentials only. Change before using these services outside local development.
POSTGRES_USER=task_app
POSTGRES_PASSWORD=task_app_local
POSTGRES_DB=task_management
REDIS_PASSWORD=redis_local
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_local
