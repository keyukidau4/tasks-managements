NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Production only: provide a random secret of at least 32 characters via the
# deployment secret store. Development generates an ephemeral process secret.
# JWT_ACCESS_SECRET=

# PostgreSQL connection string. Keep credentials local and update this URL if
# the POSTGRES_* values below are changed.
DATABASE_URL=postgresql://task_app:task_app_local@localhost:5432/task_management?schema=public

# Optional development seed account. Supply a password hash, never a plaintext password.
# SEED_USER_EMAIL=
# SEED_USER_NAME=
# SEED_USER_PASSWORD_HASH=

# Local development settings. Keep credentials only in your untracked .env.
POSTGRES_USER=task_app
POSTGRES_PASSWORD=task_app_local
POSTGRES_DB=task_management
REDIS_HOST=localhost
REDIS_PORT=6379
# Mailpit SMTP; configure SMTP credentials only in the untracked .env if needed.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@example.com
APP_URL=http://localhost:5173
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=task-attachments
# Set these locally; use the same values for the MinIO container credentials.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
